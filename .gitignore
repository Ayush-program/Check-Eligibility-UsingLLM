# ==================================================
# .gitignore — Tender Eligibility Checker
# ==================================================

# --- Secrets (MOST IMPORTANT) ---
.env
*.env
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# --- Python Virtual Environments ---
.venv/
venv/
ENV/
llmenv/

# --- Testing & Coverage ---
.pytest_cache/
htmlcov/
.coverage
coverage.xml
*.cover

# --- Build Artifacts ---
dist/
build/
*.egg-info/

# --- Database Files ---
*.db
*.sqlite
*.sqlite3

# --- User Uploaded / Downloaded Files ---
uploads/
downloads/
backend/uploads/
backend/downloads/

# --- Logs ---
*.log
logs/

# --- IDE ---
.vscode/
.idea/
pyrightconfig.json
pyrightconfig.json.bak

# --- OS ---
.DS_Store
Thumbs.db
ehthumbs.db

# --- Docker ---
.docker/

# --- AI Model Cache (large files) ---
.cache/
